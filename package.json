{
  "name": "tabletop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n servidor,web -c blue,green \"pnpm --filter @tabletop/server dev\" \"pnpm --filter @tabletop/web dev\"",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm --filter \"!@tabletop/e2e\" -r --parallel test",
    "test:e2e": "pnpm --filter @tabletop/e2e test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
